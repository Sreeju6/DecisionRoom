# DecisionRoom Environment Configuration Template
# Copy to .env and fill in your keys. All keys are optional for local testing with mocks.
# SECURITY NOTE: This app is single-user/local-only. Never expose to the internet without auth.

# =============================================================================
# LLM Providers
# =============================================================================
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
GOOGLE_API_KEY=

# Default Provider routing: "nvidia" or "google" (uses MockLLMProvider if keys are empty)
DEFAULT_LLM_PROVIDER=nvidia

# =============================================================================
# Model Routing (Must be in approved registry — see config/config.py)
# =============================================================================
MODEL_INTAKE=gemini-3.1-flash-lite
MODEL_FALLBACK=gemini-3.5-flash-lite
MODEL_SPECIALIST=gemma-4-26b-a4b-it
MODEL_SPECIALIST_REVIEW=gemma-4-31b-it
MODEL_DECISION=nvidia/nemotron-3-super-120b-a12b
MODEL_PLANNER=nvidia/nemotron-3-super-120b-a12b
MODEL_CRITIC=nvidia/nemotron-3-super-120b-a12b

# =============================================================================
# Embedding Configuration
# Set EMBEDDING_PROVIDER=hash to use FastHashEmbedder (DEGRADED-LEXICAL, for testing only).
# Default: huggingface — downloads nomic-ai/nomic-embed-text-v1.5 on first run (~270MB).
# =============================================================================
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768

# =============================================================================
# Qdrant Vector Storage
# Leave QDRANT_URL empty to use local embedded storage at storage/qdrant/
# WARNING: Changing EMBEDDING_DIMENSION after data is indexed requires re-indexing.
# =============================================================================
QDRANT_URL=
QDRANT_API_KEY=

# =============================================================================
# Web Search / Firecrawl Integration
# Set FIRECRAWL_API_KEY to enable real web research in agent analysis.
# Without this, web search returns UNAVAILABLE status (not silent empty results).
# Get a key at https://www.firecrawl.dev/
# =============================================================================
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# =============================================================================
# Concurrency & Rate Limits
# Per-provider RPM defaults (user-reported starting limits; not universal guarantees):
#   Gemma 4 26B/31B: 30 RPM, 14,400 RPD, 16,000 TPM
#   Gemini 3.1/3.5 Flash-Lite: 15 RPM, 500 RPD, 250,000 TPM
#   NVIDIA NIM Nemotron: 40 RPM
# =============================================================================
MAX_AGENT_CONCURRENCY=2
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=60
RATE_LIMIT_GEMMA_RPM=30
RATE_LIMIT_GEMINI_RPM=15
RATE_LIMIT_NVIDIA_RPM=40

# =============================================================================
# Frontend CORS Allowed Origins
# =============================================================================
DECISIONROOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.netlify.app